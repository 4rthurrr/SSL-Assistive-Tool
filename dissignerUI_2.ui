 <class>Dialog</class>
 <widget class="QDialog" name="Dialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1080</width>
    <height>720</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Mute Student Training System</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
    /* --- Main Window Background --- */
    QDialog {
        background-color: #1e1e2e; /* Dark Blue/Grey */
        color: #cdd6f4;
        font-family: &quot;Segoe UI&quot;, sans-serif;
    }

    /* --- Video Feeds (The Labels) --- */
    QLabel#Live_video, QLabel#practis_vid {
        background-color: #11111b; 
        border: 2px solid #45475a; 
        border-radius: 12px;       
    }

    /* --- Topic Title --- */
    QLabel#topic {
        color: #89b4fa; /* Soft Blue */
        font-weight: bold;
    }

    /* --- Main Button --- */
    QPushButton {
        background-color: #a6e3a1; /* Green Accent */
        color: #1e1e2e;            /* Dark text */
        border-radius: 8px;
        font-weight: bold;
        font-size: 14pt;
        border: none;
    }
    QPushButton:hover {
        background-color: #94e2d5; /* Teal on hover */
    }
    QPushButton:pressed {
        background-color: #89b4fa; /* Blue on click */
        padding-top: 2px;          
    }

    /* --- List Widget (The Selection List) --- */
    QListWidget {
        background-color: #181825;
        border: 2px solid #313244;
        border-radius: 10px;
        color: #cdd6f4;
        padding: 5px;
        font-size: 12pt;
        outline: 0; /* Removes dotted line on focus */
    }
    QListWidget::item {
        padding: 8px;
        border-radius: 5px;
        margin-bottom: 2px;
    }
    QListWidget::item:hover {
        background-color: #313244;
    }
    QListWidget::item:selected {
        background-color: #89b4fa; /* Blue selection */
        color: #1e1e2e;            /* Dark text on selection */
        font-weight: bold;
    }

    /* --- Status Label --- */
    QLabel#Display_status {
        background-color: #313244;
        color: #fab387; /* Peach/Orange text */
        border-radius: 6px;
        padding: 5px;
        font-weight: bold;
        qproperty-alignment: AlignCenter;
    }
   </string>
  </property>
